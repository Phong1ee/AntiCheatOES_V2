# Copy to .env.compose and fill the external MySQL credentials. The Compose
# topology never initializes, resets, or imports this database.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=online_exam_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
SECRET_KEY=19bgxNg5BPX5cSpWLEFIuRuEno8g5C8SeYXa_4Kygv4

# This profile passed the 250-concurrent-authenticated-user acceptance test in
# the verification environment. Its 2 API x 2-worker topology plus background
# workers has an approximate 108-connection application DB budget. Check
# max_connections and replica count before raising pools; never scale pools
# independently without recalculating the total connection budget.
UVICORN_WORKERS=2
DB_POOL_SIZE=16
DB_CONNECT_TIMEOUT=5
DB_POOL_ACQUIRE_TIMEOUT=5
DB_SQL_POOL_SIZE=4
DB_SQL_MAX_OVERFLOW=0
DB_SQL_POOL_TIMEOUT=10
# Serial background processes use one database session per job, so keep their
# reserve isolated from the API request pools.
WORKER_DB_POOL_SIZE=2
WORKER_DB_SQL_POOL_SIZE=2
WORKER_DB_SQL_MAX_OVERFLOW=0
# Exposed only on 127.0.0.1 for a backend started directly on the dev machine.
OES_REDIS_PORT=6379
REDIS_MAX_CONNECTIONS=10
REDIS_CONNECT_TIMEOUT=0.2
REDIS_SOCKET_TIMEOUT=0.2
RABBITMQ_SOCKET_TIMEOUT=1
RABBITMQ_BLOCKED_TIMEOUT=2
# Authentication-only shared Redis limits. Redis downtime fails closed for
# these routes but never blocks exam start/autosave/submit correctness.
AUTH_LOGIN_IP_LIMIT=60
AUTH_LOGIN_IP_WINDOW=900
AUTH_LOGIN_EMAIL_LIMIT=10
AUTH_LOGIN_EMAIL_WINDOW=900
AUTH_FORGOT_IP_LIMIT=20
AUTH_FORGOT_IP_WINDOW=900
AUTH_FORGOT_EMAIL_LIMIT=5
AUTH_FORGOT_EMAIL_WINDOW=900
AUTH_VERIFY_IP_LIMIT=30
AUTH_VERIFY_IP_WINDOW=900
AUTH_RESET_IP_LIMIT=10
AUTH_RESET_IP_WINDOW=900
LOG_LEVEL=INFO
OBJECT_STORAGE_BACKEND=local
# Railway staging/production: set OBJECT_STORAGE_BACKEND=s3 and all values
# below from the private S3-compatible bucket integration.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=us-east-1
