# MySQL connection settings used by the backend.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=online_exam_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# Use a long, cryptographically random value. Never commit a real value.
SECRET_KEY=replace-with-a-long-random-secret

# Runtime/CORS settings. Production and staging must set at least one explicit
# frontend origin. Separate multiple origins with commas when required.
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# CORS_ALLOWED_ORIGINS=https://frontend.example.com,https://admin.example.com

# MySQL connection-pool configuration. The default budget is 5 per process:
# api-1 + api-2 use 10 total; each future worker adds its own configured size.
DB_POOL_NAME=oes_api_pool
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT=5
# mysql-connector has fixed-size pools. A small bounded checkout wait may be
# appropriate in staging/production after measuring request latency.
DB_POOL_ACQUIRE_TIMEOUT=0

# SQLAlchemy routes have a separate bounded pool from mysql-connector routes.
DB_SQL_POOL_SIZE=5
DB_SQL_MAX_OVERFLOW=10
DB_SQL_POOL_TIMEOUT=30

# Serial outbox/worker processes use their own small pool budget. Production
# capacity must be sized across all API replicas and worker processes.
WORKER_DB_POOL_SIZE=2
WORKER_DB_SQL_POOL_SIZE=2
WORKER_DB_SQL_MAX_OVERFLOW=0

# Redis is an optional cache-aside optimization. All business mutations fall
# back to MySQL when this service is unavailable.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_MAX_CONNECTIONS=10
REDIS_CONNECT_TIMEOUT=0.2
REDIS_SOCKET_TIMEOUT=0.2

# RabbitMQ is used only for background delivery. MySQL transactions continue
# when it is unavailable; the outbox publisher retries pending records.
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
RABBITMQ_EXCHANGE=oes.events
RABBITMQ_SOCKET_TIMEOUT=1
RABBITMQ_BLOCKED_TIMEOUT=2

# Redis-backed limits apply only to authentication/password recovery. They fail
# closed with HTTP 503 if Redis is unavailable; exam-critical routes do not use
# this limiter and continue to rely on MySQL transactions.
AUTH_LOGIN_IP_LIMIT=60
AUTH_LOGIN_IP_WINDOW=900
AUTH_LOGIN_EMAIL_LIMIT=10
AUTH_LOGIN_EMAIL_WINDOW=900
AUTH_FORGOT_IP_LIMIT=20
AUTH_FORGOT_IP_WINDOW=900
AUTH_FORGOT_EMAIL_LIMIT=5
AUTH_FORGOT_EMAIL_WINDOW=900
AUTH_VERIFY_IP_LIMIT=30
AUTH_VERIFY_IP_WINDOW=900
AUTH_RESET_IP_LIMIT=10
AUTH_RESET_IP_WINDOW=900

# JSON observability output. Request IDs are accepted/generated per API call.
LOG_LEVEL=INFO
# Report workers can use this writable local development directory.
REPORT_EXPORT_DIR=generated_reports
# Private local storage for Teacher files awaiting Admin import review.
BULK_DATA_REQUEST_STORAGE_DIR=generated_bulk_requests

# Shared private object storage. Keep local for development and Compose; set
# s3 plus all S3_* values for Railway staging/production buckets.
OBJECT_STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=us-east-1

# Outgoing email, used by the forgot-password code. Keep all values empty in
# this committed template. Configure real credentials only in deployment
# secrets or an ignored backend/.env file.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10

# Preferred for Railway: Resend sends over HTTPS, which avoids outbound SMTP
# connectivity restrictions. Set both values in Railway; keep SMTP_* only as
# a local-development fallback. RESEND_FROM must be a verified Resend sender.
RESEND_API_KEY=
RESEND_FROM=
RESEND_TIMEOUT=10

# Brevo can verify a single Gmail sender and delivers over HTTPS, avoiding
# Railway's blocked SMTP path. It is preferred when both values are set.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=AntiCheat OES
BREVO_TIMEOUT=10

# Preferred for Gmail-only deployments: OAuth uses HTTPS and sends from the
# Gmail account without Railway reaching an SMTP port. Keep these as Railway
# secrets; never commit a client secret or refresh token.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REFRESH_TOKEN=
GOOGLE_GMAIL_SENDER=
GOOGLE_GMAIL_TIMEOUT=10
