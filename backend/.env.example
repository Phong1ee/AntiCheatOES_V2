# MySQL connection settings used by the backend.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=online_exam_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# MySQL connection-pool configuration. The default budget is 5 per process:
# api-1 + api-2 use 10 total; each future worker adds its own configured size.
DB_POOL_NAME=oes_api_pool
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT=5
# mysql-connector has fixed-size pools. A small bounded checkout wait may be
# appropriate in staging/production after measuring request latency.
DB_POOL_ACQUIRE_TIMEOUT=0

# SQLAlchemy routes have a separate bounded pool from mysql-connector routes.
DB_SQL_POOL_SIZE=5
DB_SQL_MAX_OVERFLOW=10
DB_SQL_POOL_TIMEOUT=30

# Serial outbox/worker processes use their own small pool budget. Production
# capacity must be sized across all API replicas and worker processes.
WORKER_DB_POOL_SIZE=2
WORKER_DB_SQL_POOL_SIZE=2
WORKER_DB_SQL_MAX_OVERFLOW=0

# Redis is an optional cache-aside optimization. All business mutations fall
# back to MySQL when this service is unavailable.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_MAX_CONNECTIONS=10
REDIS_CONNECT_TIMEOUT=0.2
REDIS_SOCKET_TIMEOUT=0.2

# RabbitMQ is used only for background delivery. MySQL transactions continue
# when it is unavailable; the outbox publisher retries pending records.
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
RABBITMQ_EXCHANGE=oes.events
RABBITMQ_SOCKET_TIMEOUT=1
RABBITMQ_BLOCKED_TIMEOUT=2

# JSON observability output. Request IDs are accepted/generated per API call.
LOG_LEVEL=INFO
# Report workers can use this writable local development directory.
REPORT_EXPORT_DIR=generated_reports
